# /etc/enkeltoverblik/site-contact.env  (root:root 0600 — systemd læser den som root)
# SMTP-værdierne er de samme som madappens platform-postkasse besked@enkeltoverblik.dk
# (data/notify.json → smtp.*). Kopiér dem — skriv dem aldrig i git.
SMTP_HOST=reseller1.chosting.dk
SMTP_PORT=587
SMTP_USER=besked@enkeltoverblik.dk
SMTP_PASS=
MAIL_FROM=Enkelt Overblik <besked@enkeltoverblik.dk>
CONTACT_TO=henrik@vores-it.dk
PORT=3100
DAILY_LIMIT=50
