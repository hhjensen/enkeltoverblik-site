# Server-blok for enkeltoverblik.dk + www som statisk site.
# Erstatter den nuværende proxy til madappen (port 3000) for netop disse to hosts.
# Behold eksisterende TLS-certifikatlinjer fra den nuværende konfiguration.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name enkeltoverblik.dk www.enkeltoverblik.dk;

    # ssl_certificate / ssl_certificate_key: kopiér fra nuværende blok

    root /var/www/enkeltoverblik-site/current;
    index index.html;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; font-src 'self'; script-src 'self'; frame-ancestors 'none'; base-uri 'self'" always;

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
