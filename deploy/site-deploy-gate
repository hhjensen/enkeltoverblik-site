#!/bin/bash
# Installeres på serveren som /usr/local/bin/site-deploy-gate (root:root 0755).
# Deploy-nøglen i /var/www/enkeltoverblik-site/.ssh/authorized_keys er låst til dette
# script med command="/usr/local/bin/site-deploy-gate". Uanset hvad der bedes om over
# SSH, kører kun dette script, og det tillader udelukkende "site-publish <id>"
# med pakken på stdin. Alt andet afvises.
set -euo pipefail
CMD="${SSH_ORIGINAL_COMMAND:-}"
if [[ "$CMD" =~ ^site-publish\ ([0-9]{8}T[0-9]{6}Z-[0-9a-f]{7})$ ]]; then
  exec /usr/local/bin/site-publish "${BASH_REMATCH[1]}"
fi
logger -t site-deploy-gate "afvist kommando fra deploy-nøglen"
echo "denied" >&2
exit 1
